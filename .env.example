# --- Pre-launch protection (Phase 6, Part 0) ---
# HTTP Basic Auth on every page while set (username: niramay). Remove at launch.
SITE_PASSWORD=
# Set to "true" ONLY on the real production domain at launch. Anything else
# sends X-Robots-Tag: noindex, nofollow and noindex robots.txt.
SITE_INDEXABLE=false

# --- Forms (Phase 6, Part 2) ---
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives form submissions (client-confirmed single address)
FORM_TO_EMAIL=ajaykaduskar@gmail.com
# Verified sender. Until niramayclinics.com is verified in Resend, previews
# may use "Niramay Clinics <onboarding@resend.dev>" (test delivery only).
FORM_FROM_EMAIL=Niramay Clinics <appointments@niramayclinics.com>
# Cloudflare Turnstile (managed). Forms skip the widget when unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# "1" = server action returns success without sending (preview/testing only;
# ignored when VERCEL_ENV=production).
FORM_TEST_MODE=

# --- Analytics (Phase 6, Part 4) — all optional; nothing loads when unset ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
